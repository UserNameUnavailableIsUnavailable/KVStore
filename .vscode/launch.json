{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug KVServer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Server/KVServer",
            "args": ["8080"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug KVClient",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Client/KVClient",
            "args": ["127.0.0.1", "8080"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug KVCommon Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Common/testing/KVCommonTesting",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
