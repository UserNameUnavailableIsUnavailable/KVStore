#if defined(__linux__)

#include "Address.hpp"
#include "Defer.hpp"
#include "RDMA_Device.hpp"
#include "RDMA_Acceptor.hpp"

#include <infiniband/verbs.h>
#include <rdma/rdma_cma.h>
#include <stdexcept>

namespace Foundation::Core
{
RDMA_Acceptor::RDMA_Acceptor(RDMA_Device &device, Address address) :
    device_(device),
    address_(std::move(address))
{
    bool ok{ true };
    make_defer([&ok, this] {
        if (!ok)
        {
            if (communication_id_)
            {
                ::rdma_destroy_id(communication_id_);
            }
            if (event_channel_)
            {
                ::rdma_destroy_event_channel(event_channel_);
            }
        }
    });
    event_channel_ = ::rdma_create_event_channel();
    if (!event_channel_) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Failed to create RDMA event channel");
    }
    if (::rdma_create_id(event_channel_, &communication_id_, nullptr, RDMA_PS_TCP)) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Failed to create RDMA ID");
    }
}

RDMA_Channel RDMA_Acceptor::accept()
{
    bool ok{ true };

    ::rdma_cm_event *event{ nullptr };
    ::rdma_cm_id *cm_id{ nullptr };

    make_defer([&]{
        if (!ok)
        {
            if (cm_id)
            {
                ::rdma_destroy_id(cm_id);
            }
        }
    });

    if (::rdma_get_cm_event(event_channel_, &event)) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Failed to get RDMA CM event");
    }
    if (event->event != RDMA_CM_EVENT_CONNECT_REQUEST) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Unexpected RDMA CM event");
    }

    cm_id = event->id; // each connection gets an id
    if (!cm_id) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Failed to get RDMA connection ID");
    }
    RDMA_Channel channel(cm_id, device_.protection_domain());
    cm_id = nullptr;

    ::rdma_conn_param param{};
    if (::rdma_accept(channel.communication_id(), &param)) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Failed to accept RDMA connection");
    }

    if (::rdma_ack_cm_event(event)) [[unlikely]]
    {
        ok = false;
        throw std::runtime_error("Failed to acknowledge RDMA CM event");
    }

    ok = false;
    return channel;
}

RDMA_Acceptor::~RDMA_Acceptor() noexcept
{
    ::rdma_destroy_id(communication_id_);
    ::rdma_destroy_event_channel(event_channel_);
}
} // namespace Foundation::Core

#endif // defined(__linux__)